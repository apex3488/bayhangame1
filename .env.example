# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL (new BAYHAN GAME 2.0 project, not the old bot database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon-level) key. Browser-safe because RLS restricts access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only. Never prefix with NEXT_PUBLIC_. Used only by admin scripts/CI.
# SUPABASE_SERVICE_ROLE_KEY=
# Database connection for migrations (Supabase dashboard > Connect). Server-only.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Telegram (docs/TELEGRAM.md) ----
# Bot username shown in "Open bot" links. Optional, defaults to BayhanGame2_bot.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=BayhanGame2_bot
# Server-only: used by scripts/telegram-setup.mjs and scripts/tg-e2e.mjs. The Edge Functions
# read the token from Supabase Vault (telegram_bot_token), never from the frontend.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# Public site URL used for the Mini App button (/tg). Optional.
# NEXT_PUBLIC_SITE_URL=https://bayhangame1.vercel.app
